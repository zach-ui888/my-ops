# ============================================================
# TG-Codex Agent configuration
# Copy this file to:
# /ops/conf/tg-codex-agent/.env
#
# NEVER commit the real .env file.
# ============================================================

# Required: Telegram Bot token
TG_BOT_TOKEN=

# Required: comma-separated Telegram User IDs allowed to use the bot
# Example:
# TG_ALLOWED_USER_IDS=123456789,987654321
TG_ALLOWED_USER_IDS=

# Root Codex CLI used only for quota/session inspection
CODEX_BIN=/root/.local/bin/codex
CODEX_HOME=/root/.codex

# Restricted Codex executor
CODEX_RUNNER_USER=codex-runner
CODEX_RUNNER_HOME=/home/codex-runner
CODEX_RUNNER_BIN=/home/codex-runner/.local/bin/codex

# All Codex project workspaces live below this directory
CODEX_WORK_ROOT=/ops/apps

# Maximum seconds for one Codex execution
CODEX_EXEC_TIMEOUT=600

# Alert when remaining Codex quota falls to this percentage or below
QUOTA_ALERT_THRESHOLD=10

# Quota monitor interval in seconds
QUOTA_CHECK_INTERVAL=3600

# Maximum age in seconds before quota data is refreshed
QUOTA_SNAPSHOT_MAX_AGE=900

# Application timezone
TZ=Asia/Shanghai
